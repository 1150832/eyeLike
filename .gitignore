# Build and binary artifacts
build/
bin/
obj/
Makefile
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# Ignore everything in the captures folder
captures/*

# Exception: do not ignore the .gitkeep file
!captures/.gitkeep

# System specific and IDE temporary files
.DS_Store
*.dSYM/
.vscode/

# C++ / Project specific
*.o
*.backup
*.tmp

# Testing and temporary output
testing/test_reports/
test_reports/telemetry/*.csv
3d_telemetry_log.csv
*.png

# Test data (keeps the repo light)
testing/test_data/
testing/test_data/*.mp4
testing/test_data/*.avi
testing/test_data/*.mov
testing/test_data/*.csv

# Ignora todos os ficheiros dentro da pasta test_reports
testing/test_reports/*

# Mas obriga o Git a rastrear o ficheiro .gitkeep (a exceção)
!testing/test_reports/.gitkeep

# IDE specific
.vscode/
.idea/

# Ignorar imagens de input e figuras geradas localmente na pasta tools/
tools/*.png
tools/*.jpg
tools/*.pdf